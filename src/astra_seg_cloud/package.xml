<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astra_seg_cloud</name>
  <version>0.1.0</version>
  <description>
    Subscribe RGB + aligned depth from an Astra depth camera, run YOLOv8-seg ONNX inference in a
    producer/consumer pipeline, deproject each eroded instance mask to a point cloud with a stable
    tracking id, and record everything to a rosbag2 for offline processing.
  </description>
  <maintainer email="zjy@example.com">zjy</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>astra_seg_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
